<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 通用机枪 IKARUS -->
  <ThingDef ParentName="SV_GeneralWeaponBase"> <!-- 继承自SV_GeneralWeaponBase -->
    <defName>SV_MG_IKARUS</defName>
    <label>MG IKARUS</label>
    <description>From ancient cycle era's Zenith LMG weapon, once it's used, it's gone for good.</description>
    <techLevel>Spacer</techLevel> <!-- 技术水平，Spacer是太空时代(极致武器) -->
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/LMG</texPath> <!-- 一个指向原版轻机枪贴图的路径 -->
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>6000</MaxHitPoints> <!-- 该物品耐久度 -->
      <MarketValue>324</MarketValue> <!-- 市场价值 -->
      <Flammability>0.0</Flammability> <!-- 物品本身的易燃度，数值越大越易燃 -->
      <DeteriorationRate>0</DeteriorationRate> <!-- 老化速率，/日 -->
      <Mass>12</Mass> <!-- 物品的质量，单位为千克 -->
      <AccuracyTouch>0.8</AccuracyTouch> <!-- 在贴近(小于3)的射击精度，一般最大为1(即100%)，数值越大越精准 -->
      <AccuracyShort>1.0</AccuracyShort> <!-- 在近距离(12左右)的射击精度，一般最大为1(即100%)，数值越大越精准 -->
      <AccuracyMedium>0.95</AccuracyMedium> <!-- 在中距离(25左右)的射击精度，一般最大为1(即100%)，数值越大越精准 -->
      <AccuracyLong>0.85</AccuracyLong> <!-- 在远距离(40+)的射击精度，一般最大为1(即100%)，数值越大越精准 -->
      <RangedWeapon_Cooldown>0.6</RangedWeapon_Cooldown> <!-- 远程武器的冷却时间，单位为秒 -->
    </statBases>
    <tradeability>None</tradeability>  <!-- 禁止交易 -->
    <relicChance>0</relicChance>  <!-- 是否可以在文化中设置为圣遗物并生成，1为可以，0不可以 -->
    <destroyOnDrop>true</destroyOnDrop>  <!-- 丢弃时自动销毁 -->
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand> <!-- 允许射击类指令 -->
        <defaultProjectile>SV_IKARUS_145X114_Bullet</defaultProjectile> <!-- 子弹类型，指向之前定义的SV_IKARUS_145x114_Bullet -->
        <warmupTime>0.4</warmupTime> <!-- 瞄准时间，单位为秒 -->
        <range>95</range> <!-- 射程，单位为格 -->
        <burstShotCount>30</burstShotCount> <!-- 连发时每次发射的子弹数量 -->
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots> <!-- 连发时每发之间的间隔，单位为游戏刻，60刻=1秒，rpm=3600/此数值 -->
        <soundCast>Shot_SniperRifle</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label> <!-- 枪管 -->
        <capacities>
          <li>Poke</li> <!-- 捅，不是钝击，这是一种独特的伤害 -->
        </capacities>
        <power>60</power> <!-- 威力 -->
        <armorPenetration>0.6</armorPenetration> <!-- 近战护甲穿透，采用百分比计数 -->
        <cooldownTime>2</cooldownTime> <!-- 近战冷却时间，单位秒，2即为2秒/下 -->
      </li>
    </tools>
  </ThingDef>

