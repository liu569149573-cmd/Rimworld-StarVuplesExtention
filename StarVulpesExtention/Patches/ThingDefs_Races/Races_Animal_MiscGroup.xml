<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- 修改Thrumbo的移动速度 -->
  <Operation Class="PatchOperationReplace">
      <xpath>*/ThingDef[defName = "Thrumbo"]/statBases/MoveSpeed</xpath> <!-- 查找Thrumbo的移动速度 -->
      <value>
          <MoveSpeed>8.6</MoveSpeed> <!-- 将移动速度设置为8.6 -->
      </value>
  </Operation>

  <!-- 修改Thrumbo的脏污生成率 -->
  <Operation Class="PatchOperationReplace">
      <xpath>*/ThingDef[defName = "Thrumbo"]/statBases/FilthRate</xpath> <!-- 查找Thrumbo的脏污生成率 -->
      <value>
          <FilthRate>1.75</FilthRate> <!-- 将脏污生成率设置为1.75 -->
      </value>
  </Operation>

  <!-- 修改Thrumbo物品的骑行速度因子 -->
  <Operation Class="PatchOperationReplace">
      <xpath>*/ThingDef[defName = "Thrumbo"]/statBases/CaravanRidingSpeedFactor</xpath> <!-- 查找Thrumbo的骑行速度因子 -->
      <value>
          <CaravanRidingSpeedFactor>4</CaravanRidingSpeedFactor> <!-- 将骑行速度因子设置为4 -->
      </value>
  </Operation>

  <!-- 为Thrumbo物品添加驮兽的属性 -->
  <Operation Class="PatchOperationAdd">
      <xpath>*/ThingDef[defName = "Thrumbo"]/race</xpath> <!-- 查找Thrumbo物品的种族信息 -->
      <value>
          <packAnimal>true</packAnimal> <!-- 将其设置为驮兽 -->
      </value>
  </Operation>

  <!-- 为Thrumbo物品添加可剪毛的组件 -->
  <Operation Class="PatchOperationAdd">
      <xpath>*/ThingDef[defName = "Thrumbo"]</xpath> <!-- 查找Thrumbo -->
      <value>
          <comps> <!-- 添加组件 -->
              <li Class="CompProperties_Shearable"> <!-- 剪毛组件 -->
                  <woolDef>ThrumboWool</woolDef> <!-- 设置剪下的毛是ThrumboWool -->
                  <shearIntervalDays>15</shearIntervalDays> <!-- 设置剪毛间隔为15天 -->
                  <woolAmount>100</woolAmount> <!-- 每次剪毛得到100单位的毛 -->
              </li>
          </comps>
      </value>
  </Operation>

</Patch>