<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 所有枪械的基础定义库，首先继承自原版BaseWeapons中最基础的BaseWeapon -->
  <!-- ================ 远程武器 ================ -->
  <!-- 无品质无艺术的远程武器 -->
  <ThingDef Name="SV_GeneralWeaponBase" ParentName="BaseGun" Abstract="True"> <!-- 定义一个继承自BaseGun的武器，名称SVE_Weapon,无品质 --> <!--这里重新引用自BaseGun是为了去除"CompProperties_Art"有关艺术的内容-->
    <comps Inherit="false"> <!-- 引用"BaseGun"类但不继承comps的内容，需要重新定义comps里的条目 -->
      <li Class="CompProperties_Forbiddable"/> <!-- 允许物品可以被设置为禁止互动 -->
      <li>
        <compClass>CompEquippable</compClass> <!-- 允许被装备 -->
      </li>
      <li Class="CompProperties_Styleable"/> <!-- 支持风格类型，如文化中的轻重武器、颜色和风格、时代武器等 -->
    </comps>
    <smeltable>false</smeltable> <!-- 不允许被熔炼 -->
  </ThingDef>

  <!-- 有品质无艺术的远程武器 -->
  <ThingDef Name="SV_QualityWeaponBase" ParentName="SV_GeneralWeaponBase" Abstract="True"> <!-- 定义一个继承自SVE_Weapon的武器，名称SVE_QualityWeaponBase，有品质无艺术 -->
    <comps>
      <li>
        <compClass>CompQuality</compClass> <!-- 允许有品质 -->
      </li>
    </comps>
    <smeltable Inherit="false">true</smeltable> <!-- 允许被熔炼 -->
  </ThingDef>

  <!-- 有品质无艺术的可制造远程武器 -->
  <ThingDef Name="SV_MakeableQualityWeaponBase" ParentName="BaseHumanMakeableGun" Abstract="True"> <!-- 定义一个继承自BaseHumanMakeableGun的武器，名称MakeableQualityWeaponBase，有品质无艺术 -->
    <comps Inherit="false">
      <li Class="CompProperties_Forbiddable"/>
      <li>
        <compClass>CompEquippable</compClass> <!-- 允许被装备 -->
      </li>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>CompQuality</compClass> <!-- 允许有品质 -->
      </li>
    </comps>
  </ThingDef>

  <!-- 正常枪械 -->
  <!-- 暂时用不到，要用直接调用原版，鸽了 -->

  <!-- ================ 子弹 ================ -->
  <!-- 通用机枪IKARUS的子弹 -->
  <ThingDef ParentName="BaseBullet"> <!-- 通用机枪IKARUS的子弹，继承自原版BaseBullet -->
    <defName>SV_IKARUS_145X114_Bullet</defName>
    <label>IKARUS bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath> <!-- 一个指向原版大子弹贴图的路径 -->
      <graphicClass>Graphic_Single</graphicClass> <!-- 贴图类型，子弹需要为Graphic_Single单一贴图 -->
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef> <!-- 伤害类型，Bullet是普通子弹 -->
      <damageAmountBase>72</damageAmountBase> <!-- 子弹的基础伤害-->
      <stoppingPower>4</stoppingPower> <!--抑止能力，这种武器的攻击会打乱目标的脚步，使其移动速度减缓数秒，体型大于抑止能力的目标不受影响-->
      <armorPenetrationBase>1.4</armorPenetrationBase> <!-- 护甲穿透，采用百分比计数 -->
      <speed>360</speed> <!-- 子弹飞行速度 -->
    </projectile>
  </ThingDef>

