  <!-- 回收塑料，就算边缘世界也有塑料垃圾 -->
  <ThingDef ParentName="ResourceBase">
    <defName>Plasticfabric</defName>
    <label>Plastic fabric</label>
    <description>Made from recycled waste plastic, it's unsightly and is easily damaged, but it can be made into very durable items. Beware of plastic pollution.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Plasticfabric</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(45,45,45)</color>
    </graphicData>
    <thingCategories>
      <li>Textiles</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <healthAffectsPrice>false</healthAffectsPrice>
  <stackLimit>1500</stackLimit>
    <statBases>
      <Mass>0.03</Mass>
      <MarketValue>0.5</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <DeteriorationRate>2</DeteriorationRate>
      <Flammability>2.0</Flammability>
      <Beauty>-6</Beauty>
      <StuffPower_Armor_Sharp>0.2</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.1</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.0</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>4</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>4</StuffPower_Insulation_Heat>
    </statBases>
    <tradeability>None</tradeability>
    <stuffProps>
      <categories>
        <li>Fabric</li>
        <li>Leathery</li>
      </categories>
      <statOffsets>
        <Beauty>-3</Beauty>
      </statOffsets>
      <color>(20,20,20)</color>
      <commonality>0.00</commonality>
      <statFactors>
        <MaxHitPoints>5.00</MaxHitPoints>
        <Flammability>2.0</Flammability>
        <Beauty>0</Beauty>
        <WorkToBuild>1.0</WorkToBuild>
        <WorkToMake>1.0</WorkToMake>
      </statFactors>
    </stuffProps>
  </ThingDef>

</Defs>