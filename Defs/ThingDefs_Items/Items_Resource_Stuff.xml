<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="WoolBase"> <!-- 定义一个新的物品类型，继承自“WoolBase”父类 -->
    <defName>ThrumboWool</defName> <!-- 物品的内部标识名称，通常用于编程和引用，这里是“ThrumboWool” -->
    <label>Thrumbo Wool</label> <!-- 物品的标签，表示物品的名称，这里是“Thrumbo Wool” -->
    <description>High-quality Thrumbo wool that can only be harvested under domesticated conditions. Far beyond the performance of its own leather makes it difficult to process. Despite this, its luxurious and durable properties still make it the first choice for making high-end handicrafts.</description>
    <graphicData>
      <color>(210,220,230)</color> <!-- 图形数据，物品的颜色，RGB值 -->
    </graphicData>
    <burnableByRecipe>false</burnableByRecipe> <!-- 是否可以通过配方对产物进行燃烧处理 -->
    <healthAffectsPrice>false</healthAffectsPrice> <!-- 物品耐久是否影响其市场价格 -->
    <statBases>
      <Mass>0.100</Mass> <!-- 物品的质量，单位为千克 -->
      <MarketValue>12.0</MarketValue> <!-- 市场价值 -->
      <MaxHitPoints>100</MaxHitPoints> <!-- 该物品耐久度 -->
      <Flammability>0.0</Flammability> <!-- 可燃性百分比，数值越大越易燃 -->
      <DeteriorationRate>100</DeteriorationRate> <!-- 老化速率，/日 -->
      <StuffPower_Armor_Sharp>3.24</StuffPower_Armor_Sharp> <!-- 利器防护 -->
      <StuffPower_Armor_Blunt>1.28</StuffPower_Armor_Blunt> <!-- 钝器防护 -->
      <StuffPower_Armor_Heat>2.56</StuffPower_Armor_Heat> <!-- 热能防护 -->
      <StuffPower_Insulation_Cold>40</StuffPower_Insulation_Cold> <!-- 隔温-寒冷 -->
      <StuffPower_Insulation_Heat>40</StuffPower_Insulation_Heat> <!-- 隔温-炎热 -->
    </statBases>
    <stuffProps>
      <color>(210,220,230)</color> <!-- 图形数据，制成品物品的颜色，RGB值 -->
      <commonality>0.00</commonality> <!-- 物品的常见程度，物品及其制成品在游戏世界中的普遍性，数值越大表示越常见 -->
      <statFactors>
        <MaxHitPoints>6.00</MaxHitPoints> <!-- 由此材料制作的物品耐久度乘数 -->
        <Flammability>0.0</Flammability> <!-- 可燃性的修改因子，影响该物品的易燃程度 -->
        <Beauty>1.6</Beauty> <!-- 美观度的修改因子，影响制成品美观度 -->
        <WorkToBuild>4.0</WorkToBuild> <!-- 建造工作量百分比，数值越大工作量越多 -->
        <WorkToMake>4.0</WorkToMake> <!-- 制作工作量百分比，数值越大工作量越多 -->
      </statFactors>
    </stuffProps>
  </ThingDef>
</Defs>