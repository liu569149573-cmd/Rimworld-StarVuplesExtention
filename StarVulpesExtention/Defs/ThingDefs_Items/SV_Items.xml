<?xml version="1.0" encoding="utf-8" ?>
<!--星狐织物-->
<Defs>
  <ThingDef ParentName="ResourceBase"> <!-- 定义一个新的物品类型，这里直接是通用资源库 -->
    <defName>SV_Fabric</defName> <!-- 物品的内部标识名称，通常用于编程和引用，这里是“SV_Fabric” -->
    <label>Starfox Fabric</label> <!-- 物品的标签，表示物品的名称，这里是“StarVulpes Fabric” -->
    <description>The common civilian fabric used by foxes in the interstellar era, but this kind of fabric cannot actually be made in Rimworld.</description> <!-- 物品描述 -->
    <graphicData> <!-- 图形数据 -->
      <texPath>Things/Item/Resource/SV_Fabric/SV_Fabric</texPath> <!-- 图形数据-贴图路径，要从Texture目录下的文件夹开始，StackCount可以只写到包含三种贴图的文件夹，Single需对应到具体一个贴图 -->
      <graphicClass>Graphic_Single</graphicClass> <!-- 贴图类型，StackCount需要abc三种堆叠程度的贴图，Single为单一贴图 -->
      <color>(155,205,255)</color> <!-- 图形数据，掉落物物品的颜色，RGB值，此数值为直接覆盖在原贴图上的颜色 -->
    </graphicData>
    <thingCategories> <!-- 物品分类 -->
      <li>Leathers</li> <!-- 物品分类-皮革 -->
      <li>Textiles</li> <!-- 物品分类-织物 -->
    </thingCategories>
    <useHitPoints>false</useHitPoints> <!-- 是否启用掉落物物品耐久 -->
    <burnableByRecipe>false</burnableByRecipe> <!-- 是否可以通过配方对产物进行燃烧处理 -->
    <healthAffectsPrice>false</healthAffectsPrice> <!-- 物品耐久是否影响其市场价格 -->
    <stackLimit>3000</stackLimit> <!-- 最大堆叠数量 -->
    <statBases> <!-- 物品属性，按游戏内显示顺序，但部分statFactors属性需要写在这里 -->
      <!--MaxHitPoints>112900</MaxHitPoints> < 该物品耐久度，这里因为useHitPoints设置为了false所以不启用 -->
      <MarketValue>3.24</MarketValue> <!-- 市场价值 -->
      <Flammability>0.0</Flammability> <!-- 物品本身的易燃度，数值越大越易燃 -->
      <Mass>0.041</Mass> <!-- 物品的质量，单位为千克 -->
      <!--DeteriorationRate>1</DeteriorationRate> < 老化速率，/日，同理不启用 -->
      <StuffPower_Armor_Sharp>6.00</StuffPower_Armor_Sharp> <!-- 利器防护 -->
      <StuffPower_Armor_Blunt>6.00</StuffPower_Armor_Blunt> <!-- 钝器防护 -->
      <StuffPower_Armor_Heat>6.00</StuffPower_Armor_Heat> <!-- 热能防护 -->
      <StuffPower_Insulation_Cold>46</StuffPower_Insulation_Cold> <!-- 隔温-寒冷 -->
      <StuffPower_Insulation_Heat>46</StuffPower_Insulation_Heat> <!-- 隔温-炎热 -->
      <Beauty>1</Beauty>  <!-- 美观度的修改因子，影响物品及制成品的直接美观度，填了正值就能直接把东西丢地上还不扣美观 -->
    </statBases>
    <!--tradeability>Sellable</tradeability> < 可交易性，None是禁止买卖，Sellable是只能卖给NPC -->
    <!--relicChance>0</relicChance>  < 作为战利品生成几率，一般不用管，不想被作为战利品刷新就填0 -->
    <!--destroyOnDrop>true</destroyOnDrop>  < 掉落时是否销毁，true为掉落即消失，无法缴获 -->
    <stuffProps>
      <categories> <!-- 物品用途分类 -->
        <li>Fabric</li> <!-- 物品作为材料时可以当作布料 -->
        <li>Leathery</li> <!-- 物品作为材料时可以当作皮革 -->
      </categories>
      <color>(155,205,255)</color> <!-- 图形数据，制成品物品的颜色，RGB值 -->
      <commonality>0.00</commonality> <!-- 物品的常见程度，由其制成的物品在游戏世界中的普遍性，数值越大表示越常见 -->
      <statFactors> <!-- 以此材料制作时属性乘数，按游戏内显示顺序，但部分属性需写在statBases下 -->
        <MaxHitPoints>41.00</MaxHitPoints> <!-- 由此材料制作的物品耐久度乘数 -->
        <WorkToBuild>1.6</WorkToBuild> <!-- 建造工作量百分比，数值越大工作量越多 -->
        <WorkToMake>1.6</WorkToMake> <!-- 制作工作量百分比，数值越大工作量越多 -->
        <Flammability>0.0</Flammability> <!-- 制成品的易燃度，数值越大越易燃 -->
        <Beauty>6</Beauty> <!-- 美观度的修改因子，影响制成品美观度 -->
      </statFactors>
      <statOffsets> <!-- 以此材料制作时属性偏移量 -->
        <Beauty>4</Beauty> <!-- 美观度，作为织物的美观度只有在做成建筑时才有用，金地砖是11，银地砖和精致地毯是4，精致石地砖是3，普通地毯是2，石地砖是1，无菌地砖是-1 -->
        <Cleanliness>1</Cleanliness> <!-- 清洁度，作为织物的清洁度只有在做成建筑时才有用，普通材料是0，金属地砖是0.2，无菌地砖是0.6， -->
      </statOffsets>
    </stuffProps>
  </ThingDef>

