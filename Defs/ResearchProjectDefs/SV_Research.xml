<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ResearchTabDef>
    <defName>SV_ResearchTab</defName> <!--研究页面名称全局唯一 -->
    <label>Starfox Tech</label> <!--研究页面可见名称 -->
  </ResearchTabDef>
  
  <!--研究选项-联系星狐，大前置不解锁任何东西，未来会在完成后解锁一个可联系的派系 -->
  <ResearchProjectDef>
    <defName>SV_ContactWithStarfox</defName> <!--研究选项名称全局唯一 -->
    <label>Contact with Starfox</label> <!-- 选项的可见名称 -->
    <description>Contact with Starfox</description> <!-- 描述 -->
    <tab>SV_ResearchTab</tab> <!-- 所属研究页面，关联于<ResearchTabDef>下的<defName> -->
    <techLevel>Spacer</techLevel> <!--科技时代 -->
    <baseCost>112900</baseCost> <!--研究的基础花费，没错就是这么多，致敬群星的更多兽耳娘模组，最好用科技核心跳过 -->
    <prerequisites> <!--前置条件 -->
     <li>MicroelectronicsBasics</li> <!--前置条件-微电子基础 -->
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding> <!--需要研究台-高级研究台 -->
    <requiredResearchFacilities> <!--需要研究设施 -->
      <li>MultiAnalyzer</li> <!--多元分析仪 -->
    </requiredResearchFacilities>
    <researchViewX>0</researchViewX> <!--研究选项左右位置 -->
    <researchViewY>3</researchViewY> <!--研究选项上下位置 -->
  </ResearchProjectDef>

  <!--研究选项-星狐布料，目前计划在机械加工台上解锁一个配方，未来可能是开放派系的购买或用Anomaly的仪式召唤 -->
  <ResearchProjectDef>
    <defName>SV_Fabric_Recipe</defName> <!--研究选项名称全局唯一 -->
    <label>Learn to get Starfox Fabric</label> <!-- 选项的可见名称 -->
    <description>Learn to get Starfox Fabric</description> <!-- 描述 -->
    <tab>SV_ResearchTab</tab> <!-- 所属研究页面，关联于<ResearchTabDef>下的<defName> -->
    <techLevel>Spacer</techLevel> <!--科技时代 -->
    <baseCost>1600</baseCost> <!--研究的基础花费 -->
    <prerequisites> <!--前置条件 -->
      <li>SV_ContactWithStarfox</li> <!--前置条件-联系星狐 -->
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding> <!--需要研究台-高级研究台 -->
    <researchViewX>1</researchViewX> <!--研究选项左右位置 -->
    <researchViewY>1</researchViewY> <!--研究选项上下位置 -->
  </ResearchProjectDef>

  <!--研究选项-异世界武器 -->
  <ResearchProjectDef>
    <defName>SV_NW_Weapon_Recipe</defName> <!--研究选项名称全局唯一 -->
    <label>New world weapons</label> <!-- 选项的可见名称 -->
    <description>Learn to make some new weapons.</description> <!-- 描述 -->
    <tab>SV_ResearchTab</tab> <!-- 所属研究页面，关联于<ResearchTabDef>下的<defName> -->
    <techLevel>Industrial</techLevel> <!--工业时代 -->
    <baseCost>800</baseCost> <!--研究的基础花费 -->
    <prerequisites> <!--前置条件 -->
      <li>Gunsmithing</li> <!--前置条件-枪械制作 -->
    </prerequisites>
    <researchViewX>1</researchViewX> <!--研究选项左右位置 -->
    <researchViewY>0</researchViewY> <!--研究选项上下位置 -->
  </ResearchProjectDef>

</Defs>